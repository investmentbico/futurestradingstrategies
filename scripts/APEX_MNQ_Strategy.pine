//@version=5
strategy("🏆 WINNER MNQ Strategy - Optimized 2026", 
     overlay=true, 
     calc_on_every_tick=true,
     pyramiding=0,
     default_qty_type=strategy.fixed,
     default_qty_value=15)  // OPTIMIZED: 15 contracts

// ---------------- OPTIMIZED INPUTS (WINNER PARAMETERS) ----------------
fastEMA       = input.int(21, "Fast EMA", minval=1)  // OPTIMIZED
slowEMA       = input.int(55, "Slow EMA", minval=1)  // OPTIMIZED
stochK        = input.int(9, "Stoch %K Length")     // OPTIMIZED
stochD        = input.int(3, "Stoch %D Length")     // OPTIMIZED
stochSmooth   = input.int(2, "Stoch Smooth")        // OPTIMIZED
stochLo       = input.int(25, "Stoch Low Threshold")  // OPTIMIZED
stochHi       = input.int(75, "Stoch High Threshold") // OPTIMIZED

atrLen        = input.int(9, "ATR Length")           // OPTIMIZED
atrMultSL     = input.float(2.0, "ATR Multiplier for SL", step=0.1)  // OPTIMIZED
takeProfitRR  = input.float(1.8, "Take Profit (R:R)", step=0.1)      // OPTIMIZED
hardStopDollars = input.float(80.0, "Hard Stop Loss ($)", step=1.0)  // OPTIMIZED: $80 hard stop

useTP         = input.bool(true, "Use TP (enable/disable)")
useTrailing   = input.bool(false, "Use ATR trailing stop")  // DISABLED for hard stop focus
breakevenAfterProfit = input.float(3.0, "Move SL to breakeven after points", step=0.1)

// ---------------- CALCULATIONS ----------------
emaFast = ta.ema(close, fastEMA)
emaSlow = ta.ema(close, slowEMA)
atrVal = ta.atr(atrLen)

// Stochastic Oscillator - OPTIMIZED PARAMETERS
[stochKVal, stochDVal] = ta.stoch(close, high, low, stochK)
stochKSmooth = ta.sma(stochKVal, stochD)
stochDSmooth = ta.sma(stochKSmooth, stochSmooth)

// Trend and Stochastic conditions - OPTIMIZED LOGIC
isBull = emaFast > emaSlow
isBear = emaFast < emaSlow
stochFalling = stochDSmooth < stochDSmooth[1]
stochRising = stochDSmooth > stochDSmooth[1]

// Entry signals - OPTIMIZED
longSignal  = isBull and stochFalling and stochDSmooth <= stochLo
shortSignal = isBear and stochRising and stochDSmooth >= stochHi

// optional time filter
inTimeWindow = not timeFilterEnable ? true : (hour >= startHour and hour < endHour)

// entry triggers
longSignal  = isBull and rsiVal > rsiLongThresh and allowBarRange and inTimeWindow and momentum
shortSignal = isBear and rsiVal < rsiShortThresh and allowBarRange and inTimeWindow and not momentum

// ---------------- POSITION SIZING & SL/TP ----------------
// OPTIMIZED: Fixed 15 contracts with $80 hard stop
qty = 15  // OPTIMIZED: Fixed contract size

// ATR-based stops (secondary)
slDist = atrVal * atrMultSL
if slDist <= syminfo.mintick
    slDist := syminfo.mintick

// Hard stop prices - OPTIMIZED PRIMARY STOP LOSS
long_hard_stop = close - (hardStopDollars / (qty * syminfo.pointvalue))
short_hard_stop = close + (hardStopDollars / (qty * syminfo.pointvalue))

// ATR-based exit prices (secondary stops)
long_atr_stop = close - slDist
short_atr_stop = close + slDist
long_tp_price = useTP ? close + slDist * takeProfitRR : na
short_tp_price = useTP ? close - slDist * takeProfitRR : na

// ---------------- ENTRIES ----------------
if (longSignal and strategy.position_size == 0)
    // place entry with OPTIMIZED parameters
    strategy.entry("Long", strategy.long, qty=qty)
    // Dual exit system: Hard stop (primary) + ATR stop (secondary)
    strategy.exit("Exit Long", from_entry="Long",
                   stop=long_hard_stop,  // PRIMARY: Hard $80 stop
                   limit=long_tp_price)
    label.new(bar_index, low, "🏆 WINNER LONG\n15 contracts\n$80 hard stop",
              style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, yloc=yloc.belowbar)

if (shortSignal and strategy.position_size == 0)
    strategy.entry("Short", strategy.short, qty=qty)
    strategy.exit("Exit Short", from_entry="Short",
                   stop=short_hard_stop,  // PRIMARY: Hard $80 stop
                   limit=short_tp_price)
    label.new(bar_index, high, "🏆 WINNER SHORT\n15 contracts\n$80 hard stop",
              style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, yloc=yloc.abovebar)

// ---------------- BREAKEVEN (Optional) ----------------
if (strategy.position_size > 0 and (close - strategy.position_avg_price) >= breakevenAfterProfit)
    strategy.exit("BE Long", from_entry="Long", stop=strategy.position_avg_price)

if (strategy.position_size < 0 and (strategy.position_avg_price - close) >= breakevenAfterProfit)
    strategy.exit("BE Short", from_entry="Short", stop=strategy.position_avg_price)

// ---------------- PLOTTING ----------------
plot(emaFast, title="EMA Fast (21)", color=color.orange, linewidth=2)
plot(emaSlow, title="EMA Slow (55)", color=color.blue, linewidth=2)

// Stochastic levels - OPTIMIZED
hline(stochLo, "Stoch Low (25)", color=color.green, linestyle=hline.style_dashed)
hline(stochHi, "Stoch High (75)", color=color.red, linestyle=hline.style_dashed)

// Stochastic plot
plot(stochDSmooth, title="Stoch %D", color=color.purple, linewidth=1)

// Signal indicators
plotshape(longSignal ? emaFast : na, title="Long Signal", location=location.belowbar,
          style=shape.triangleup, size=size.small, color=color.green)
plotshape(shortSignal ? emaSlow : na, title="Short Signal", location=location.abovebar,
          style=shape.triangledown, size=size.small, color=color.red)

// ---------------- INFO LABEL - OPTIMIZED STRATEGY ----------------
var infoLabel = label.new(bar_index, na, "")
if barstate.islast
    label.set_xy(infoLabel, bar_index, high)
    label.set_text(infoLabel, "🏆 WINNER MNQ 2026\n15 contracts | $80 hard stop\nP&L: $12.1M | PF: 64.2\nMax DD: $2,377")
    label.set_style(infoLabel, label.style_label_right)
    label.set_color(infoLabel, color.new(color.green, 90))