# Webull API Credentials
# Get these from https://developer.webull.com/
WEBULL_APP_KEY=your_app_key_here
WEBULL_APP_SECRET=your_app_secret_here

# Rithmic / Apex Trader Funding Credentials
# Get these from your Apex dashboard or welcome email
RITHMIC_USER=your_rithmic_username
RITHMIC_PASSWORD=your_rithmic_password
RITHMIC_SYSTEM_NAME=Apex
# Gateway URL - choose closest to you:
#   Chicago: rituz01000.rithmic.com:443
#   Seoul:   rituz01001.rithmic.com:443
#   Test:    rituz00100.rithmic.com:443
RITHMIC_GATEWAY_URL=rituz01000.rithmic.com:443

# TradersPost.io Webhook (Apex/Tradovate integration)
# Get this from TradersPost dashboard > Webhooks > Copy URL
TRADERSPOST_WEBHOOK_URL=https://webhooks.traderspost.io/trading/webhook/YOUR_UUID/YOUR_PASSWORD
# Ticker: Use base symbol (MNQ), NOT contract code (MNQH6).
# TradersPost resolves the front-month contract automatically.
TRADERSPOST_TICKER=MNQ

# Trading Parameters (optional - defaults will be used if not set)
TRADING_SYMBOL=MNQ
TRADING_CONTRACTS=3
MAX_TRADES_PER_SESSION=10
ACCOUNT_RISK_PERCENT=0.5